<div class="card">
  <h1>Login Page</h1>

  <% if flash[:error] %>
    <p class="error"><%= flash[:error] %></p>
  <% end %>
  <% if flash[:notice] %>
    <p class="success"><%= flash[:notice] %></p>
  <% end %>

  <%= form_tag login_path, method: :post do %>
    <div>
      <%= label_tag :username %>
      <%= text_field_tag :username %>
    </div>
    <div>
      <%= label_tag :password %>
      <%= password_field_tag :password %>
    </div>
    <div>
      <%= submit_tag "Login" %>
    </div>
  <% end %>
</div>